tls:
  stores:
    default:
      defaultCertificate:
        certFile: /certs/wildcard.crt
        keyFile: /certs/wildcard.key

http:
  middlewares:
    secure-headers:
      headers:
        stsSeconds: 31536000
        contentTypeNosniff: true
        referrerPolicy: no-referrer
    factures-auth:
      basicAuth:
        realm: "Factures Anonyme Expertise"
        users:
          - "{{ vault_factures_basicauth }}"
    factures-ratelimit:
      rateLimit:
        average: 10
        burst: 20
    factures-taille:
      buffering:
        maxRequestBodyBytes: 10485760

  routers:
    vault:
      rule: Host(`vault.{{ domain }}`)
      entryPoints: [websecure]
      service: vault
      middlewares: [secure-headers]
      tls: {}
    factures:
      rule: Host(`factures.{{ domain }}`)
      entryPoints: [websecure]
      service: factures
      middlewares: [secure-headers, factures-ratelimit, factures-taille, factures-auth]
      tls: {}
    factures-healthz:
      rule: Host(`factures.{{ domain }}`) && Path(`/healthz`)
      priority: 100
      entryPoints: [websecure]
      service: factures
      middlewares: [secure-headers]
      tls: {}    
    grafana:
      rule: Host(`grafana.{{ domain }}`)
      entryPoints: [websecure]
      service: grafana
      middlewares: [secure-headers]
      tls: {}

  services:
    vault:
      loadBalancer:
        servers: [{ url: "http://{{ ips.apps }}:8081" }]
    factures:
      loadBalancer:
        servers: [{ url: "http://{{ ips.apps }}:8000" }]
    grafana:
      loadBalancer:
        servers: [{ url: "http://{{ ips.obs }}:3000" }]

entryPoints:
  web:
    address: ":80"
    http:
      aliasHeadersStrategy: delete
      redirections:
        entryPoint: { to: websecure, scheme: https }
  websecure:
    address: ":443"
    http:
      aliasHeadersStrategy: delete
  metrics:
    address: ":8082"
    http:
      aliasHeadersStrategy: delete

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

metrics:
  prometheus:
    entryPoint: metrics

accessLog:
  filePath: /var/log/traefik/access.log
  format: json

log:
  level: INFO

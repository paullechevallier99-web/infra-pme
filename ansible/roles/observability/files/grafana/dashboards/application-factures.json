{
  "title": "Application factures",
  "uid": "application-factures",
  "schemaVersion": 39,
  "tags": ["infra-pme", "application"],
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "1m",
  "panels": [
    {"type": "stat", "title": "Factures déposées (24 h)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(factures_uploads_total{status='accepted'}[24h]))"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 1},
    {"type": "stat", "title": "Taux de classement automatique (24 h)", "description": "Part des factures classées sans intervention humaine", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(factures_classement_total{resultat='classee'}[24h])) / clamp_min(sum(increase(factures_classement_total[24h])), 1)"}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 0.8}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 2},
    {"type": "stat", "title": "Factures à vérifier (24 h)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(factures_classement_total{resultat='a_verifier'}[24h]))"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 3},
    {"type": "stat", "title": "File d'attente du worker", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(factures_queue_length)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 50}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 4},
    {"type": "timeseries", "title": "Dépôts par minute", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(factures_uploads_total{status='accepted'}[5m])) * 60", "legendFormat": "acceptés"}, {"refId": "B", "expr": "sum(rate(factures_uploads_total{status='rejected'}[5m])) * 60", "legendFormat": "rejetés"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15, "stacking": {"mode": "none"}}}, "overrides": []}, "id": 5},
    {"type": "timeseries", "title": "Résultat du classement par heure", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (resultat) (increase(factures_classement_total[1h]))", "legendFormat": "{{resultat}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15, "stacking": {"mode": "normal"}}}, "overrides": []}, "id": 6},
    {"type": "timeseries", "title": "Latence de dépôt (p95)", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(factures_upload_seconds_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"fillOpacity": 15, "stacking": {"mode": "none"}}}, "overrides": []}, "id": 7},
    {"type": "timeseries", "title": "Erreurs du worker par heure", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(factures_processed_total{status='error'}[1h]))", "legendFormat": "erreurs"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15, "stacking": {"mode": "none"}}}, "overrides": []}, "id": 8},
    {"type": "logs", "title": "Journaux du worker", "gridPos": {"x": 0, "y": 21, "w": 24, "h": 9}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{container=`apps-worker-1`}"}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}, "id": 9}
  ]
}

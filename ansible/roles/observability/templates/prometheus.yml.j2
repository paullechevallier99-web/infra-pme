global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files: [/etc/prometheus/rules/*.yml]

alerting:
  alertmanagers:
    - static_configs: [{ targets: ["alertmanager:9093"] }]

scrape_configs:
  - job_name: node
    static_configs:
{% for h in groups['all'] %}
      - targets: ["{{ hostvars[h].ansible_host | default(h) }}:9100"]
        labels: { host: "{{ h }}" }
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for h in groups['all'] %}
      - targets: ["{{ hostvars[h].ansible_host | default(h) }}:8080"]
        labels: { host: "{{ h }}" }
{% endfor %}

  - job_name: factures-api
    metrics_path: /metrics/
    static_configs: [{ targets: ["{{ ips.apps }}:8000"], labels: { host: apps } }]

  - job_name: factures-worker
    static_configs: [{ targets: ["{{ ips.apps }}:9200"], labels: { host: apps } }]

  - job_name: traefik
    static_configs: [{ targets: ["{{ ips.edge }}:8082"], labels: { host: edge } }]

  - job_name: garage
    static_configs: [{ targets: ["{{ ips.backup }}:3903"], labels: { host: backup } }]

  - job_name: blackbox-https
    metrics_path: /probe
    params: { module: [https_2xx] }
    static_configs:
      - targets:
{% for t in observability_probe_targets %}
          - "{{ t }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
